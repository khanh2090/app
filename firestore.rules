rules_version = '2';

// Security rules for the Fitness Companion backend.
// Paste into Firebase Console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's profile, step history and workouts are private to that user.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Any signed-in user can read the day's leaderboard; each user writes only their own entry.
    match /leaderboard/{day}/entries/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // The exercise catalogue is public to read; signed-in users may publish it.
    match /guides/{guideId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
